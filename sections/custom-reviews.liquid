{{ 'custom-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-reviews.js' | asset_url }}" defer></script>

{%- assign title_id = 'CustomReviewsTitle-' | append: section.id -%}
{%- assign track_id = 'CustomReviewsTrack-' | append: section.id -%}
<custom-reviews
  class="custom-reviews"
  style="
    --reviews-background: {{ section.settings.background | default: 'var(--color-background)' }};
    --reviews-text: {{ section.settings.text_color | default: 'var(--color-foreground)' }};
    --reviews-card: {{ section.settings.card_background | default: '#EFF7EB' }};
    --reviews-quote: {{ section.settings.quote_color | default: '#153527' }};
    --reviews-desktop-size: {{ section.settings.heading_desktop }}px;
    --reviews-mobile-size: {{ section.settings.heading_mobile }}px;
    --reviews-desktop-padding: {{ section.settings.padding_desktop }}px;
    --reviews-mobile-padding: {{ section.settings.padding_mobile }}px;
    --reviews-spacing: {{ section.settings.spacing }}px;
  "
>
  <section class="custom-reviews__inner" aria-labelledby="{{ title_id }}">
    <div class="custom-reviews__header">
      <{{ section.settings.heading_tag }} class="custom-reviews__heading" id="{{ title_id }}">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
      {% if section.blocks.size > 1 %}
        <div class="custom-reviews__controls" hidden>
          <button class="button-secondary" type="button" aria-label="Previous review" aria-controls="{{ track_id }}" data-review-step="-1">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <button class="button-secondary" type="button" aria-label="Next review" aria-controls="{{ track_id }}" data-review-step="1">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      {% endif %}
    </div>
    <div class="custom-reviews__track" id="{{ track_id }}" role="region" aria-labelledby="{{ title_id }}" tabindex="0">
      <ul class="custom-reviews__list" role="list">
        {% for block in section.blocks %}
          <li class="custom-reviews__card" {{ block.shopify_attributes }}>
            <figure>
              {% if block.settings.quote != blank %}
                <blockquote>{{ block.settings.quote | escape | newline_to_br }}</blockquote>
              {% endif %}
              {% if block.settings.name != blank or block.settings.company != blank or block.settings.role != blank %}
                <figcaption>
                  {%- liquid
                    echo block.settings.name | escape
                    if block.settings.company != blank
                      if block.settings.name != blank
                        echo ', '
                      endif
                      echo block.settings.company | escape
                    endif
                    if block.settings.role != blank
                      if block.settings.name != blank or block.settings.company != blank
                        echo ' '
                      endif
                      echo block.settings.role | escape
                    endif
                  -%}
                </figcaption>
              {% endif %}
            </figure>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
</custom-reviews>

{% schema %}
{
  "name": "Custom reviews carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What clients say" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "default": "h2", "options": [
      { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }
    ] },
    { "type": "color", "id": "background", "label": "Section background" },
    { "type": "color", "id": "text_color", "label": "Section text" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#EFF7EB" },
    { "type": "color", "id": "quote_color", "label": "Quote colour", "default": "#153527" },
    { "type": "range", "id": "heading_desktop", "label": "Desktop heading size", "min": 24, "max": 84, "step": 1, "unit": "px", "default": 46 },
    { "type": "range", "id": "heading_mobile", "label": "Mobile heading size", "min": 20, "max": 60, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding_desktop", "label": "Desktop vertical padding", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_mobile", "label": "Mobile vertical padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "spacing", "label": "Space below heading", "min": 8, "max": 64, "step": 2, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "company", "label": "Company" },
        { "type": "text", "id": "role", "label": "Role" }
      ]
    }
  ],
  "presets": [{
    "name": "Custom reviews carousel",
    "blocks": [
      { "type": "review", "settings": { "quote": "“Daniel was a huge breath of fresh air.”", "name": "Shandi Nichelle", "company": "FREEWELL", "role": "founder" } },
      { "type": "review", "settings": { "quote": "“Dan has been so good, professional, and easy to work with.”", "company": "Ring Leader Games" } }
    ]
  }]
}
{% endschema %}
