{{ 'custom-why-monarch.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign comparison_rows = section.blocks | where: 'type', 'comparison_row'
  assign stat_cards = section.blocks | where: 'type', 'stat'
  assign columns = 'freelancer,monarch,agency' | split: ','
  assign title_id = 'CustomWhyMonarch-' | append: section.id
  assign mobile_cards = ''
-%}

<section class="custom-why-monarch" aria-labelledby="{{ title_id }}" style="
  --why-background: {{ section.settings.background_color | default: 'var(--color-background)' }};
  --why-text: {{ section.settings.text_color | default: 'var(--color-foreground)' }};
  --why-highlight: {{ section.settings.highlight_color | default: 'var(--why-tint)' }};
  --why-card-background: {{ section.settings.card_background | default: 'var(--why-tint)' }};
  --why-card-text: {{ section.settings.card_text | default: 'var(--why-text)' }};
  --why-card-value: {{ section.settings.card_value_color | default: 'var(--why-card-text)' }};
  --why-card-label: {{ section.settings.card_label_color | default: 'var(--why-card-text)' }};
  --why-card-alignment: {{ section.settings.card_alignment | default: 'left' }};
  --why-logo-width-desktop: {{ section.settings.logo_width_desktop | default: 90 }}px;
  --why-logo-width-mobile: {{ section.settings.logo_width_mobile | default: 90 }}px;
  --why-heading-desktop: {{ section.settings.heading_desktop }}px;
  --why-heading-mobile: {{ section.settings.heading_mobile }}px;
  --why-gap: {{ section.settings.spacing }}px;
  --why-gap-mobile: {{ section.settings.spacing_mobile }}px;
  --why-padding-top: {{ section.settings.padding_top }}px;
  --why-padding-bottom: {{ section.settings.padding_bottom }}px;
  --why-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
  --why-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
">
  <div class="custom-why-monarch__content">
    <div class="custom-why-monarch__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="custom-why-monarch__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <{{ section.settings.heading_tag }} id="{{ title_id }}" class="custom-why-monarch__heading">
        {{ section.settings.heading | escape }}
      </{{ section.settings.heading_tag }}>
      {% if section.settings.introduction != blank %}
        <p class="custom-why-monarch__lead">{{ section.settings.introduction | escape | newline_to_br }}</p>
      {% endif %}
    </div>

    {% if comparison_rows.size > 0 %}
      <div class="custom-why-monarch__comparison">
        <div class="custom-why-monarch__scroll" role="region" tabindex="0" aria-labelledby="{{ title_id }}">
          <table class="custom-why-monarch__table">
            <caption class="visually-hidden">{{ section.settings.table_caption | escape }}</caption>
            <colgroup>
              <col class="custom-why-monarch__label-column">
              <col span="3">
            </colgroup>
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">{{ section.settings.feature_heading | escape }}</span></th>
                <th scope="col">{{ section.settings.freelancer_heading | escape }}</th>
                <th scope="col" class="custom-why-monarch__highlight">
                  {% if section.settings.monarch_logo != blank %}
                    {{ section.settings.monarch_logo | image_url: width: 360 | image_tag: alt: section.settings.monarch_heading }}
                  {% else %}
                    {{ section.settings.monarch_heading | escape }}
                  {% endif %}
                </th>
                <th scope="col">{{ section.settings.agency_heading | escape }}</th>
              </tr>
            </thead>
            <tbody>
              {% for block in comparison_rows %}
                {% assign mobile_results = '' %}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row">{{ block.settings.label | escape }}</th>
                  {% for column in columns %}
                    {% capture indicator %}
                      {% case block.settings[column] %}
                        {% when 'check' %}
                          <span role="img" aria-label="Yes" class="custom-why-monarch__check">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"/></svg>
                          </span>
                        {% when 'cross' %}
                          <span role="img" aria-label="No" class="custom-why-monarch__cross">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>
                          </span>
                        {% when 'question' %}
                          <span role="img" aria-label="Question mark" class="custom-why-monarch__question">?</span>
                      {% endcase %}
                    {% endcapture %}
                    <td{% if column == 'monarch' %} class="custom-why-monarch__highlight"{% endif %}>{{ indicator }}</td>
                    {% assign heading_key = column | append: '_heading' %}
                    {% capture mobile_result %}
                      <div{% if column == 'monarch' %} class="custom-why-monarch__highlight"{% endif %}>
                        <dt>{{ section.settings[heading_key] | escape }}</dt>
                        <dd>{{ indicator }}</dd>
                      </div>
                    {% endcapture %}
                    {% assign mobile_results = mobile_results | append: mobile_result %}
                  {% endfor %}
                </tr>
                {% capture mobile_card %}
                  <li {{ block.shopify_attributes }}>
                    <p>{{ block.settings.label | escape }}</p>
                    <dl>{{ mobile_results }}</dl>
                  </li>
                {% endcapture %}
                {% assign mobile_cards = mobile_cards | append: mobile_card %}
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% if section.settings.monarch_logo != blank %}
          <div class="custom-why-monarch__mobile-logo">
            {{ section.settings.monarch_logo | image_url: width: 360 | image_tag: alt: '' }}
          </div>
        {% endif %}
        <ul class="custom-why-monarch__mobile-cards" role="list">{{ mobile_cards }}</ul>
        {% if section.settings.footnote != blank %}
          <p class="custom-why-monarch__footnote">{{ section.settings.footnote | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if stat_cards.size > 0 %}
      <ul class="custom-why-monarch__stats" role="list">
        {% for block in stat_cards %}
          <li {{ block.shopify_attributes }}>
            <p class="custom-why-monarch__value">{{ block.settings.value | escape }}</p>
            <p class="custom-why-monarch__stat-label">{{ block.settings.label | escape }}</p>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Custom Why Monarch",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Monarch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The best of both worlds"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "introduction",
      "label": "Introduction",
      "default": "AI is a useful tool. Knowing what to build—and how to make it work for your business—takes experience. Monarch combines CPG knowledge, considered design and hands-on Shopify development, using AI where it helps and applying human judgement throughout."
    },
    {
      "type": "text",
      "id": "table_caption",
      "label": "Table caption",
      "default": "Monarch compared with a solo freelancer and a traditional agency"
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "Row-label heading",
      "default": "Feature"
    },
    {
      "type": "text",
      "id": "freelancer_heading",
      "label": "First column heading",
      "default": "Solo freelancer"
    },
    {
      "type": "text",
      "id": "monarch_heading",
      "label": "Monarch heading and logo alt text",
      "default": "Monarch Web Solutions"
    },
    {
      "type": "image_picker",
      "id": "monarch_logo",
      "label": "Monarch logo"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Desktop Monarch logo width",
      "min": 30,
      "max": 300,
      "step": 3,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Mobile Monarch logo width",
      "min": 30,
      "max": 180,
      "step": 3,
      "unit": "px",
      "default": 90
    },
    {
      "type": "text",
      "id": "agency_heading",
      "label": "Third column heading",
      "default": "Traditional agency"
    },
    {
      "type": "text",
      "id": "scroll_hint",
      "label": "Mobile scroll hint",
      "default": "Scroll sideways to compare all three options."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Comparison footnote",
      "default": "Typical setups shown. Scope and inclusions vary by provider."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Section text"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Monarch column background"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Stat card background"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Stat card text"
    },
    {
      "type": "color",
      "id": "card_value_color",
      "label": "Stat value colour",
      "info": "Leave empty to use the shared stat card text colour."
    },
    {
      "type": "color",
      "id": "card_label_color",
      "label": "Stat label colour",
      "info": "Leave empty to use the shared stat card text colour."
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Stat card text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "heading_desktop",
      "label": "Desktop heading size",
      "min": 36,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 66
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "label": "Mobile heading size",
      "min": 24,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Desktop section content spacing",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
