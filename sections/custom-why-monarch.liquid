          "label": "Value"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Why Monarch",
      "blocks": [
        {
          "type": "comparison_row",
          "settings": {
            "label": "Founder-led design & development",
