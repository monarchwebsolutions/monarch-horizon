{{ 'custom-client-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-client-slider.js' | asset_url }}" defer></script>

{%- liquid
  assign background = section.settings.background_color | default: 'var(--color-background)'
  assign foreground = section.settings.text_color | default: 'var(--color-foreground)'
  assign image_width = section.settings.desktop_width | at_least: section.settings.mobile_width | times: 3
-%}
{%- capture image_sizes -%}
  (max-width: 760px) {{ section.settings.mobile_width }}px, {{ section.settings.desktop_width }}px
{%- endcapture -%}

<custom-client-slider
  class="custom-client-slider"
  {% if section.settings.autoplay %}data-autoplay="{{ section.settings.speed }}"{% endif %}
  style="
    --custom-client-background: {{ background }};
    --custom-client-foreground: {{ foreground }};
    --custom-client-ratio: {{ section.settings.image_ratio }};
    --custom-client-desktop-width: {{ section.settings.desktop_width }}px;
    --custom-client-mobile-width: {{ section.settings.mobile_width }}px;
    --custom-client-desktop-gap: {{ section.settings.desktop_gap }}px;
    --custom-client-mobile-gap: {{ section.settings.mobile_gap }}px;
    --custom-client-desktop-top: {{ section.settings.desktop_top }}px;
    --custom-client-desktop-bottom: {{ section.settings.desktop_bottom }}px;
    --custom-client-mobile-top: {{ section.settings.mobile_top }}px;
    --custom-client-mobile-bottom: {{ section.settings.mobile_bottom }}px;
  "
>
  <div class="custom-client-slider__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="custom-client-slider__heading" id="CustomClientHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div
        class="custom-client-slider__viewport"
        tabindex="0"
        role="region"
        {% if section.settings.heading != blank %}
          aria-labelledby="CustomClientHeading-{{ section.id }}"
        {% else %}
          aria-label="Client websites"
        {% endif %}
      >
        <div class="custom-client-slider__track">
          <ul class="custom-client-slider__list" role="list">
            {%- for block in section.blocks -%}
              {%- assign client_name = block.settings.name | default: 'Client website' -%}
              <li class="custom-client-slider__card" {{ block.shopify_attributes }}>
                {%- if block.settings.url != blank -%}
                  <a class="custom-client-slider__link" href="{{ block.settings.url | escape }}"{% if block.settings.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                {%- endif -%}
                <figure class="custom-client-slider__figure">
                  {%- if block.settings.image != blank -%}
                    {%- assign image_alt = 'Screenshot of the ' | append: client_name | append: ' website' -%}
                    {{
                      block.settings.image
                      | image_url: width: image_width
                      | image_tag: class: 'custom-client-slider__image', widths: '240, 360, 480, 600, 720, 960, 1200, 1440', sizes: image_sizes, loading: 'lazy', alt: image_alt
                    }}
                  {%- else -%}
                    <div class="custom-client-slider__placeholder">Website screenshot placeholder</div>
                  {%- endif -%}
                  <figcaption class="custom-client-slider__caption">
                    <span class="custom-client-slider__name">{{ client_name | escape }}</span>
                    {%- if block.settings.note != blank -%}
                      <span class="custom-client-slider__note">{{ block.settings.note | escape | newline_to_br }}</span>
                    {%- endif -%}
                  </figcaption>
                </figure>
                {%- if block.settings.url != blank -%}
                  {%- if block.settings.new_tab -%}<span class="visually-hidden"> (opens in a new tab)</span>{%- endif -%}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
  </div>
</custom-client-slider>

{% schema %}
{
  "name": "Custom client slider",
  "tag": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected clients"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text override"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Autoplay speed (pixels per second)",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 30
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "1000 / 541",
      "options": [
        {
          "value": "1000 / 541",
          "label": "Reference (1000:541)"
        },
        {
          "value": "16 / 9",
          "label": "16:9"
        },
        {
          "value": "3 / 2",
          "label": "3:2"
        }
      ]
    },
    {
      "type": "range",
      "id": "desktop_width",
      "label": "Desktop card width",
      "min": 200,
      "max": 480,
      "step": 5,
      "default": 290,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_width",
      "label": "Mobile card width",
      "min": 160,
      "max": 360,
      "step": 2,
      "default": 236,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desktop_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 96,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desktop_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 96,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 96,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 96,
      "step": 2,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "client",
      "name": "Client",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Website screenshot"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Business name",
          "default": "Client name"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Supporting text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Website URL"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open link in a new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom client slider",
      "blocks": [
        {
          "type": "client",
          "settings": {
            "name": "Craftmix"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "StronGRR Supplements"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Greenpet"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Keepshield"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Golp"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "PitchFit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
