<div {{ block.shopify_attributes }}>
  {% if block.settings.services != blank %}
    <p class="monarch-hero-services">{{ block.settings.services | escape }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Hero services",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "services",
      "label": "Services line",
      "default": "New storefronts • Rebuilds • Migrations • CRO • SEO • Custom development"
    }
  ]
}
{% endschema %}
